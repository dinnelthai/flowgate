# File path: /etc/systemd/system/flowgate.service
# sudo systemctl daemon-reload
# sudo systemctl start flowgate
# sudo systemctl enable flowgate
# sudo systemctl status flowgate
[Unit]
Description=FlowGate Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/flowgate  # 注意修改路径
ExecStart=/path/to/flowgate/flowgate --port 3000 --log-dir /path/to/flowgate/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
